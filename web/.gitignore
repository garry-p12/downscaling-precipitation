# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated field tiles, one directory per study (~50 MB). Rebuild with:
#   python scripts/gen_web_tiles.py --out web/public/data           --wettest 130 --stride 11
#   python scripts/gen_web_tiles.py --out web/public/data-colorado  --wettest 130 --stride 11
#   python scripts/gen_web_tiles.py --out web/public/data-power     --wettest 130 --stride 11
/public/data
/public/data-*
