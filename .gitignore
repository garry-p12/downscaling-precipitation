# data & model artefacts (large / regenerable)
data/raw/
data/processed/
data/auxiliary/
data/*.log
models/*.pkl
# Model output: regenerable from the pipeline and far too large for git.
# `results/*.nc` only matched the top level, which let 3.1 GB into history via
# results/final, results/v2 and results/v3 -- a clean clone had to check all of
# it out. The web viewer's PNG tiles are a deliberate exception and are kept by
# web/.gitignore, because the site is deployed from a clean clone.
results/*.nc
results/**/*.nc
results/**/*.png
results/**/*.csv
results/*.png

# ...but the curated, labelled figure set IS part of the repo
!results/figures/
!results/figures/**
!results/figures/*.png
!results/figures/README.md
!results/comparison/*.json
!results/comparison/*.md
!results/*.json
!results/*.md

# python
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# env / editor
.env
.DS_Store
.vscode/

# Written documents: the paper, the summaries, the slide decks and the planning
# notes. Ignored because they are drafts in progress rather than repository
# documentation, and a public remote is the wrong place for them until they are
# finished. They stay on disk; `git rm --cached` is what removed them from the
# index, since .gitignore alone never untracks a file that is already tracked.
#
# The exclamations below keep the files the repository needs to explain and
# build itself, which would otherwise be swept up by docs/ and *.md.
docs/*.md
IMERG_Downscaling_Plan.md
!README.md
!web/README.md
!web/CLAUDE.md
!web/AGENTS.md
!results/**/*.md
